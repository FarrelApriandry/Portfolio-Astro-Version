---
import AdminShell from '../../components/admin/AdminShell.astro';
import Field from '../../components/admin/Field.astro';
import TextareaField from '../../components/admin/TextareaField.astro';
import FormCard from '../../components/admin/FormCard.astro';
import { isAdminAuthenticated } from '../../lib/admin';
import { sections } from '../../lib/admin-sections';
import { getPortfolioData } from '../../lib/db';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const data = await getPortfolioData();
const notice = Astro.url.searchParams.get('notice') ?? '';
const errorMessage = Astro.url.searchParams.get('error') ?? '';

const counts: Array<{ key: string; label: string; value: string }> = [
  { key: 'socials', label: 'Socials', value: String(data.socials.length) },
  { key: 'skill_groups', label: 'Skill Groups', value: String(data.skillGroups.length) },
  { key: 'experiences', label: 'Experiences', value: String(data.experiences.length) },
  { key: 'educations', label: 'Educations', value: String(data.educations.length) },
  { key: 'projects', label: 'Projects', value: String(data.projects.length) },
  { key: 'awards', label: 'Awards', value: String(data.awards.length) },
  { key: 'intellectual_properties', label: 'IP Records', value: String(data.intellectualProperties.length) },
];
---

<AdminShell
  title="Overview"
  description="Everything on your portfolio, editable in one place. Pick a section to manage its content."
  active="overview"
  notice={notice}
  degraded={data.degraded}
>
  {errorMessage ? <div class="mb-6 rounded-xl border border-[#fca5a5]/30 bg-[#fca5a5]/5 px-4 py-3.5 text-sm text-[#fca5a5]" role="alert">{errorMessage}</div> : null}

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {counts.map((item) => (
      <a href={`/admin/${item.key}`} class="group rounded-xl border border-[#262626] bg-[#111111] p-4 transition-colors hover:border-[#7DD3A7]/40">
        <p class="text-sm text-[#A1A1A1]">{item.label}</p>
        <p class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-[#F5F5F5]">{item.value}</p>
        <p class="mt-2 text-xs text-[#7DD3A7] opacity-0 transition-opacity group-hover:opacity-100">Manage →</p>
      </a>
    ))}
  </div>

  <div class="mt-10">
    <FormCard label="Profile" error={data.degraded ? 'Editing is disabled while the database is unreachable.' : ''}>
      <form method="POST" action="/api/admin/profile" class="space-y-5">
        <div class="grid gap-5 md:grid-cols-2">
          <Field name="name" label="Name" value={data.profile?.name ?? ''} required />
          <Field name="role" label="Role" value={data.profile?.role ?? ''} required />
        </div>
        <TextareaField name="value_statement" label="Value statement" value={data.profile?.value_statement ?? ''} rows={3} hint="The short pitch under your name on the homepage." />
        <div class="grid gap-5 md:grid-cols-2">
          <Field name="status" label="Status" value={data.profile?.status ?? ''} placeholder="e.g. Open to work" />
          <Field name="location" label="Location" value={data.profile?.location ?? ''} />
          <Field name="email" label="Email" value={data.profile?.email ?? ''} type="email" />
          <Field name="resume" label="Resume URL" value={data.profile?.resume ?? ''} hint="Link shown in the header CTA." />
        </div>
        <div class="flex justify-end border-t border-[#1f1f1f] pt-5">
          <button type="submit" class="min-h-[44px] rounded-lg bg-[#7DD3A7] px-6 text-sm font-semibold text-[#0A0A0A] transition-colors hover:bg-[#a7e3c4]">
            Save profile
          </button>
        </div>
      </form>
    </FormCard>
  </div>

  <div class="mt-10 grid gap-3 sm:grid-cols-2">
    {sections.filter((section) => section.key !== 'profile').map((section) => (
      <a href={`/admin/${section.key}`} class="rounded-xl border border-[#262626] bg-[#111111] p-5 transition-colors hover:border-[#3a3a3a]">
        <h2 class="text-base font-medium text-[#F5F5F5]">{section.label}</h2>
        <p class="mt-1 text-sm text-[#A1A1A1]">{section.description}</p>
      </a>
    ))}
  </div>
</AdminShell>
