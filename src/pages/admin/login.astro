---
import Layout from '../../layouts/Layout.astro';
import {
  canReadFormData,
  checkLoginRateLimit,
  getClientIp,
  isAdminConfigured,
  recordFailedLogin,
  setAdminAuthenticated,
  verifyAdminCredentials,
} from '../../lib/admin';

const formState = {
  email: '',
};

const errors = {
  email: '',
  password: '',
};

const misconfigured = !isAdminConfigured();

if (Astro.request.method === 'POST' && canReadFormData(Astro.request)) {
  const ip = getClientIp(Astro.request);
  const { allowed, retryAfterSeconds } = checkLoginRateLimit(ip);

  if (!allowed) {
    errors.email = `Too many attempts. Try again in ${retryAfterSeconds}s.`;
  } else if (misconfigured) {
    errors.email = 'Admin login is not configured on this deployment.';
  } else {
    const formData = await Astro.request.formData();
    const email = String(formData.get('email') ?? '');
    const password = String(formData.get('password') ?? '');

    formState.email = email;

    if (!email) errors.email = 'Email is required';
    if (!password) errors.password = 'Password is required';

    if (!errors.email && !errors.password) {
      if (await verifyAdminCredentials(email, password)) {
        setAdminAuthenticated(Astro.cookies);
        return Astro.redirect('/admin');
      }
      recordFailedLogin(ip);
      // Generic message — do not reveal whether the email or password was wrong.
      errors.email = 'Invalid email or password';
      errors.password = 'Invalid email or password';
    }
  }
} else if (Astro.request.method === 'POST') {
  errors.email = 'Unsupported form submission';
  errors.password = 'Unsupported form submission';
}
---

<Layout title="Admin Login | Farrel Apriandry" noindex={true}>
  <main class="mx-auto flex min-h-screen max-w-5xl items-center justify-center px-4 py-16 sm:px-6">
    <div class="w-full max-w-md rounded-2xl border border-[#262626] bg-[#111111] p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.02)] sm:p-8">
      <p class="mono text-[10px] uppercase tracking-[0.24em] text-[#7DD3A7]">Admin Access</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-[-0.06em] text-[#F5F5F5]">Sign in</h1>
      <p class="mt-3 text-sm text-[#A1A1A1]">Manage portfolio content from a single dashboard.</p>

      {misconfigured ? (
        <p class="mt-6 rounded-md border border-[#fca5a5]/30 bg-[#fca5a5]/5 px-3 py-2.5 text-sm text-[#fca5a5]">
          Admin login is not configured. Set ADMIN_EMAIL, ADMIN_PASSWORD_HASH, and ADMIN_SESSION_SECRET (see .env.example).
        </p>
      ) : null}

      <form method="POST" enctype="application/x-www-form-urlencoded" class="mt-8 space-y-5">
        <div>
          <label for="email" class="mb-2 block mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            value={formState.email}
            class="w-full rounded-md border border-[#262626] bg-[#0A0A0A] px-3 py-2.5 text-[#F5F5F5] outline-none transition-colors focus:border-[#7DD3A7]"
          />
          {errors.email ? <p class="mt-2 text-sm text-[#fca5a5]">{errors.email}</p> : null}
        </div>

        <div>
          <label for="password" class="mb-2 block mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            class="w-full rounded-md border border-[#262626] bg-[#0A0A0A] px-3 py-2.5 text-[#F5F5F5] outline-none transition-colors focus:border-[#7DD3A7]"
          />
          {errors.password ? <p class="mt-2 text-sm text-[#fca5a5]">{errors.password}</p> : null}
        </div>

        <button type="submit" class="w-full rounded-md border border-[#7DD3A7]/50 bg-[#7DD3A7]/10 px-4 py-3 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15">
          Sign in to dashboard
        </button>
      </form>
    </div>
  </main>
</Layout>
