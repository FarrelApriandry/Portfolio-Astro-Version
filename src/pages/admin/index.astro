                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Title</span>
                  <input name="title" value={editingProject?.title ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Year</span>
                  <input name="year" type="number" value={editingProject?.year ?? new Date().getFullYear()} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Category</span>
                  <input name="category" value={editingProject?.category ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Role</span>
                  <input name="role" value={editingProject?.role ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Summary</span>
                  <textarea name="summary" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingProject?.summary ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Problem</span>
                  <textarea name="problem" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingProject?.problem ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Solution</span>
                  <textarea name="solution" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingProject?.solution ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Technologies (comma separated)</span>
                  <input name="technologies" value={editingProject ? joinList(editingProject.technologies) : ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Image</span>
                  <input name="image" value={editingProject?.image ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Alt text</span>
                  <input name="alt" value={editingProject?.alt ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="flex items-center gap-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <input name="featured" type="checkbox" checked={editingProject?.featured ?? false} class="h-4 w-4 rounded border-[#262626] bg-[#111111] text-[#7DD3A7]" />
                  <span>Featured project</span>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Links as JSON</span>
                  <textarea name="links" rows="4" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 font-mono text-sm text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingProject?.links ? JSON.stringify(editingProject.links, null, 2) : ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Role responsibilities (comma separated)</span>
                  <input name="role_responsibilities" value={editingProject ? joinList(editingProject.role_responsibilities) : ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Architecture notes</span>
                  <textarea name="architecture_notes" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingProject?.architecture_notes ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Gallery (comma separated)</span>
                  <input name="gallery" value={editingProject ? joinList(editingProject.gallery) : ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
              </div>
              <button type="submit" class="rounded-md border border-[#7DD3A7]/50 bg-[#7DD3A7]/10 px-4 py-2.5 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15">
                {editingProject ? 'Update project' : 'Add project'}
              </button>
            </form>

            <div class="grid gap-3">
              {data.projects.map((item) => (
                <article class="rounded-xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-start justify-between gap-4">
                    <div class="space-y-2">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-base font-medium text-[#F5F5F5]">{item.title}</p>
                        {item.featured ? <span class="rounded-full border border-[#1f3f2b] bg-[#0f1b14] px-2 py-0.5 text-[10px] uppercase tracking-[0.16em] text-[#7DD3A7]">Featured</span> : null}
                      </div>
                      <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">{item.category} · {item.year} · {item.role}</p>
                      <p class="text-sm leading-6 text-[#D4D4D4]">{item.summary}</p>
                      <div class="flex flex-wrap gap-2">
                        {item.technologies.map((technology) => (
                          <span class="rounded-full border border-[#262626] bg-[#111111] px-2.5 py-1 text-xs text-[#D4D4D4]">{technology}</span>
                        ))}
                      </div>
                    </div>
                    <div class="flex gap-2">
                      <a href={`/admin?edit=projects:${item.id}#projects`} class="rounded-md border border-[#262626] px-3 py-1.5 text-xs text-[#F5F5F5] transition-colors hover:border-[#3a3a3a] hover:bg-[#161616]">
                        Edit
                      </a>
                      <form method="POST">
                        <input type="hidden" name="section" value="projects" />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={item.id} />
                        <button type="submit" class="rounded-md border border-[#3f1f1f] px-3 py-1.5 text-xs text-[#fca5a5] transition-colors hover:bg-[#1b0f0f]">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="awards" class="rounded-2xl border border-[#262626] bg-[#111111] p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-semibold tracking-[-0.05em] text-[#F5F5F5]">Awards</h2>
              <p class="mt-1 text-sm text-[#A1A1A1]">Recognitions and awards.</p>
            </div>
            {errors.awards ? <div class="rounded-md border border-[#3f1f1f] bg-[#1b0f0f] px-3 py-2 text-sm text-[#fca5a5]">{errors.awards}</div> : null}
          </div>

          <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
            <form method="POST" enctype="application/x-www-form-urlencoded" class="space-y-4 rounded-xl border border-[#262626] bg-[#0A0A0A] p-4">
              <input type="hidden" name="section" value="awards" />
              <input type="hidden" name="action" value={editingAward ? 'update' : 'create'} />
              {editingAward ? <input type="hidden" name="id" value={editingAward.id} /> : null}
              <div class="flex items-center justify-between gap-3">
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">{editingAward ? `Editing #${editingAward.id}` : 'Add award'}</p>
                {editingAward ? <a href="/admin#awards" class="text-xs text-[#7DD3A7]">Cancel edit</a> : null}
              </div>
              <div class="grid gap-4 md:grid-cols-2">
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Year</span>
                  <input name="year" type="number" value={editingAward?.year ?? new Date().getFullYear()} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Issuer</span>
                  <input name="issuer" value={editingAward?.issuer ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Title</span>
                  <input name="title" value={editingAward?.title ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Description</span>
                  <textarea name="description" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingAward?.description ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Link</span>
                  <input name="link" value={editingAward?.link ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
              </div>
              <button type="submit" class="rounded-md border border-[#7DD3A7]/50 bg-[#7DD3A7]/10 px-4 py-2.5 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15">
                {editingAward ? 'Update award' : 'Add award'}
              </button>
            </form>

            <div class="grid gap-3">
              {data.awards.map((item) => (
                <article class="rounded-xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">{item.year}</p>
                      <p class="mt-1 text-base font-medium text-[#F5F5F5]">{item.title}</p>
                      <p class="text-sm text-[#A1A1A1]">{item.issuer}</p>
                      <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">{item.description}</p>
                      {item.link ? <a href={item.link} target="_blank" rel="noreferrer" class="mt-2 block break-all text-sm text-[#7DD3A7]">{item.link}</a> : null}
                    </div>
                    <div class="flex gap-2">
                      <a href={`/admin?edit=awards:${item.id}#awards`} class="rounded-md border border-[#262626] px-3 py-1.5 text-xs text-[#F5F5F5] transition-colors hover:border-[#3a3a3a] hover:bg-[#161616]">
                        Edit
                      </a>
                      <form method="POST">
                        <input type="hidden" name="section" value="awards" />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={item.id} />
                        <button type="submit" class="rounded-md border border-[#3f1f1f] px-3 py-1.5 text-xs text-[#fca5a5] transition-colors hover:bg-[#1b0f0f]">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section id="intellectual_properties" class="rounded-2xl border border-[#262626] bg-[#111111] p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-semibold tracking-[-0.05em] text-[#F5F5F5]">Intellectual Properties</h2>
              <p class="mt-1 text-sm text-[#A1A1A1]">Hak Kekayaan Intelektual and similar records.</p>
            </div>
            {errors.intellectual_properties ? <div class="rounded-md border border-[#3f1f1f] bg-[#1b0f0f] px-3 py-2 text-sm text-[#fca5a5]">{errors.intellectual_properties}</div> : null}
          </div>

          <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
            <form method="POST" enctype="application/x-www-form-urlencoded" class="space-y-4 rounded-xl border border-[#262626] bg-[#0A0A0A] p-4">
              <input type="hidden" name="section" value="intellectual_properties" />
              <input type="hidden" name="action" value={editingIp ? 'update' : 'create'} />
              {editingIp ? <input type="hidden" name="id" value={editingIp.id} /> : null}
              <div class="flex items-center justify-between gap-3">
                <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">{editingIp ? `Editing #${editingIp.id}` : 'Add IP record'}</p>
                {editingIp ? <a href="/admin#intellectual_properties" class="text-xs text-[#7DD3A7]">Cancel edit</a> : null}
              </div>
              <div class="grid gap-4 md:grid-cols-2">
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Year</span>
                  <input name="year" type="number" value={editingIp?.year ?? new Date().getFullYear()} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4]">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Type</span>
                  <input name="type" value={editingIp?.type ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Title</span>
                  <input name="title" value={editingIp?.title ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Issuer</span>
                  <input name="issuer" value={editingIp?.issuer ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Description</span>
                  <textarea name="description" rows="3" class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]">{editingIp?.description ?? ''}</textarea>
                </label>
                <label class="space-y-2 text-sm text-[#D4D4D4] md:col-span-2">
                  <span class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">Link</span>
                  <input name="link" value={editingIp?.link ?? ''} class="w-full rounded-md border border-[#262626] bg-[#111111] px-3 py-2 text-[#F5F5F5] outline-none focus:border-[#7DD3A7]" />
                </label>
              </div>
              <button type="submit" class="rounded-md border border-[#7DD3A7]/50 bg-[#7DD3A7]/10 px-4 py-2.5 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15">
                {editingIp ? 'Update IP record' : 'Add IP record'}
              </button>
            </form>

            <div class="grid gap-3">
              {data.intellectualProperties.map((item) => (
                <article class="rounded-xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#A1A1A1]">{item.year} · {item.type}</p>
                      <p class="mt-1 text-base font-medium text-[#F5F5F5]">{item.title}</p>
                      <p class="text-sm text-[#A1A1A1]">{item.issuer}</p>
                      <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">{item.description}</p>
                      {item.link ? <a href={item.link} target="_blank" rel="noreferrer" class="mt-2 block break-all text-sm text-[#7DD3A7]">{item.link}</a> : null}
                    </div>
                    <div class="flex gap-2">
                      <a href={`/admin?edit=intellectual_properties:${item.id}#intellectual_properties`} class="rounded-md border border-[#262626] px-3 py-1.5 text-xs text-[#F5F5F5] transition-colors hover:border-[#3a3a3a] hover:bg-[#161616]">
                        Edit
                      </a>
                      <form method="POST">
                        <input type="hidden" name="section" value="intellectual_properties" />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={item.id} />
                        <button type="submit" class="rounded-md border border-[#3f1f1f] px-3 py-1.5 text-xs text-[#fca5a5] transition-colors hover:bg-[#1b0f0f]">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
