---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title = 'Farrel Apriandry | Full-Stack Software Engineer',
  description = 'Farrel Apriandry builds scalable software systems, developer tools, and modern web platforms with TypeScript and Docker.',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const baseURL = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, baseURL);
const imageURL = new URL(image, baseURL);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Farrel Apriandry',
  url: baseURL.toString(),
  jobTitle: 'Full-Stack TypeScript / Software Engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Magelang', addressCountry: 'ID' },
  sameAs: ['https://github.com/FarrelApriandry', 'https://linkedin.com/in/farrelapriandry'],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#0A0A0A] text-[#F5F5F5]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Farrel Apriandry" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="753" />
    <meta property="og:image:alt" content="Farrel Apriandry Portfolio Preview" />
    <meta property="og:site_name" content="Farrel Apriandry Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content="Farrel Apriandry Portfolio Preview" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F5F5] antialiased selection:bg-[#7DD3A7]/20 selection:text-[#F5F5F5]">
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
