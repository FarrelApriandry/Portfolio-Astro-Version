---
import AdminShell from '../../components/admin/AdminShell.astro';
import Field from '../../components/admin/Field.astro';
import TextareaField from '../../components/admin/TextareaField.astro';
import FormCard from '../../components/admin/FormCard.astro';
import { isAdminAuthenticated } from '../../lib/admin';
import { sectionByKey } from '../../lib/admin-sections';
import { getPortfolioData } from '../../lib/db';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const meta = sectionByKey.get('intellectual_properties')!;
const data = await getPortfolioData();
const notice = Astro.url.searchParams.get('notice') ?? '';
const errorMessage = Astro.url.searchParams.get('error') ?? '';
const editId = Number(Astro.url.searchParams.get('edit') ?? 0);
const editing = data.intellectualProperties.find((item) => item.id === editId) ?? null;
---

<AdminShell
  title={editing ? 'Edit IP record' : 'IP Records'}
  description={editing ? `Editing “${editing.title}”.` : meta.description}
  active="intellectual_properties"
  notice={notice}
  degraded={data.degraded}
>
  {errorMessage ? <div class="mb-6 rounded-xl border border-[#fca5a5]/30 bg-[#fca5a5]/5 px-4 py-3.5 text-sm text-[#fca5a5]" role="alert">{errorMessage}</div> : null}

  <FormCard label={editing ? `Editing #${editing.id}` : 'Add IP record'} error={data.degraded ? 'Editing is disabled while the database is unreachable.' : ''}>
    <form method="POST" action="/api/admin/sections" class="space-y-5">
      <input type="hidden" name="section" value="intellectual_properties" />
      <input type="hidden" name="action" value={editing ? 'update' : 'create'} />
      {editing ? <input type="hidden" name="id" value={editing.id} /> : null}
      <div class="grid gap-5 md:grid-cols-3">
        <Field name="year" label="Year" value={editing?.year ?? new Date().getFullYear()} type="number" />
        <Field name="type" label="Type" value={editing?.type ?? ''} required placeholder="e.g. Hak Cipta" />
        <Field name="issuer" label="Issuer" value={editing?.issuer ?? ''} required placeholder="e.g. Kemenkumham" />
        <Field name="title" label="Title" value={editing?.title ?? ''} required span2 />
      </div>
      <TextareaField name="description" label="Description" value={editing?.description ?? ''} rows={3} />
      <Field name="link" label="Link" value={editing?.link ?? ''} type="url" hint="Optional — certificate or registry entry." />
      <div class="flex flex-col gap-3 border-t border-[#1f1f1f] pt-5 sm:flex-row sm:justify-end">
        {editing ? <a href="/admin/ip" class="min-h-[44px] rounded-lg border border-[#2E2E2E] px-5 text-center text-sm leading-[42px] text-[#A1A1A1] transition-colors hover:bg-[#161616] hover:text-[#F5F5F5]">Cancel</a> : null}
        <button type="submit" class="min-h-[44px] rounded-lg bg-[#7DD3A7] px-6 text-sm font-semibold text-[#0A0A0A] transition-colors hover:bg-[#a7e3c4]">
          {editing ? 'Save changes' : 'Add IP record'}
        </button>
      </div>
    </form>
  </FormCard>

  <h2 class="mb-4 mt-10 text-lg font-semibold text-[#F5F5F5]">Existing records <span class="text-sm font-normal text-[#8a8a8a]">({data.intellectualProperties.length})</span></h2>
  <div class="grid gap-4">
    {data.intellectualProperties.map((item) => (
      <article class="flex flex-col gap-3 rounded-xl border border-[#262626] bg-[#111111] p-4 sm:flex-row sm:items-start sm:justify-between sm:p-5">
        <div class="min-w-0">
          <p class="mono text-[11px] uppercase tracking-[0.18em] text-[#8a8a8a]">{item.year} · {item.type}</p>
          <h3 class="mt-1 text-base font-medium text-[#F5F5F5]">{item.title}</h3>
          <p class="text-sm text-[#A1A1A1]">{item.issuer}</p>
          {item.description ? <p class="mt-2 text-sm leading-6 text-[#A1A1A1]">{item.description}</p> : null}
          {item.link ? <a href={item.link} target="_blank" rel="noreferrer" class="mt-1 block truncate text-sm text-[#7DD3A7]">{item.link}</a> : null}
        </div>
        <div class="flex shrink-0 gap-2">
          <a href={`/admin/ip?edit=${item.id}`} class="min-h-[44px] rounded-lg border border-[#2E2E2E] px-4 text-sm leading-[42px] text-[#F5F5F5] transition-colors hover:bg-[#161616]">Edit</a>
          <form method="POST" action="/api/admin/sections" data-confirm={`Delete “${item.title}”?`}>
            <input type="hidden" name="section" value="intellectual_properties" />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={item.id} />
            <button type="submit" class="min-h-[44px] rounded-lg border border-[#3f1f1f] px-4 text-sm text-[#fca5a5] transition-colors hover:bg-[#1b0f0f]">Delete</button>
          </form>
        </div>
      </article>
    ))}
    {data.intellectualProperties.length === 0 ? <p class="rounded-xl border border-dashed border-[#2E2E2E] px-4 py-10 text-center text-sm text-[#8a8a8a]">No IP records yet — add your first one above.</p> : null}
  </div>
</AdminShell>
