# Public template — copy to .env.local for local dev.
# NEVER commit real values. Set the same keys in Vercel Project Settings → Environment Variables.

# Neon Postgres (pooled). Get from Neon dashboard → Connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin dashboard auth
ADMIN_EMAIL=you@example.com
# Generate with: node scripts/gen-admin-hash.mjs "<password-min-12-chars>"
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<saltHex>:<keyHex>
# Long random secret (script prints one alongside the hash)
ADMIN_SESSION_SECRET=<64-hex-chars-min>
