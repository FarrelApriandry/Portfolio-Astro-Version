---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title = 'Farrel Apriandry | Full-Stack Software Engineer',
  description = 'Farrel Apriandry builds scalable software systems, developer tools, and modern web platforms with TypeScript and PostgreSQL.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#0A0A0A] text-[#F5F5F5]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F5F5] antialiased selection:bg-[#7DD3A7]/20 selection:text-[#F5F5F5]">
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
