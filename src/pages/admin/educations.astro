---
import AdminShell from '../../components/admin/AdminShell.astro';
import Field from '../../components/admin/Field.astro';
import TextareaField from '../../components/admin/TextareaField.astro';
import FormCard from '../../components/admin/FormCard.astro';
import { isAdminAuthenticated } from '../../lib/admin';
import { sectionByKey } from '../../lib/admin-sections';
import { getPortfolioData } from '../../lib/db';

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const meta = sectionByKey.get('educations')!;
const data = await getPortfolioData();
const notice = Astro.url.searchParams.get('notice') ?? '';
const errorMessage = Astro.url.searchParams.get('error') ?? '';
const editId = Number(Astro.url.searchParams.get('edit') ?? 0);
const editing = data.educations.find((item) => item.id === editId) ?? null;
---

<AdminShell
  title={editing ? 'Edit education' : 'Educations'}
  description={editing ? `Editing “${editing.degree}”.` : meta.description}
  active="educations"
  notice={notice}
  degraded={data.degraded}
>
  {errorMessage ? <div class="mb-6 rounded-xl border border-[#fca5a5]/30 bg-[#fca5a5]/5 px-4 py-3.5 text-sm text-[#fca5a5]" role="alert">{errorMessage}</div> : null}

  <FormCard label={editing ? `Editing #${editing.id}` : 'Add education'} error={data.degraded ? 'Editing is disabled while the database is unreachable.' : ''}>
    <form method="POST" action="/api/admin/sections" class="space-y-5">
      <input type="hidden" name="section" value="educations" />
      <input type="hidden" name="action" value={editing ? 'update' : 'create'} />
      {editing ? <input type="hidden" name="id" value={editing.id} /> : null}
      <div class="grid gap-5 md:grid-cols-2">
        <Field name="period" label="Period" value={editing?.period ?? ''} required placeholder="e.g. 2024 — Present" />
        <Field name="institution" label="Institution" value={editing?.institution ?? ''} required />
        <Field name="degree" label="Degree / Program" value={editing?.degree ?? ''} required span2 />
      </div>
      <TextareaField name="details" label="Details" value={editing?.details ?? ''} rows={3} hint="Optional — GPA, focus, activities." />
      <Field name="sort_order" label="Sort order" value={editing?.sort_order ?? 0} type="number" hint="Lower numbers appear first on the site." />
      <div class="flex flex-col gap-3 border-t border-[#1f1f1f] pt-5 sm:flex-row sm:justify-end">
        {editing ? <a href="/admin/educations" class="min-h-[44px] rounded-lg border border-[#2E2E2E] px-5 text-center text-sm leading-[42px] text-[#A1A1A1] transition-colors hover:bg-[#161616] hover:text-[#F5F5F5]">Cancel</a> : null}
        <button type="submit" class="min-h-[44px] rounded-lg bg-[#7DD3A7] px-6 text-sm font-semibold text-[#0A0A0A] transition-colors hover:bg-[#a7e3c4]">
          {editing ? 'Save changes' : 'Add education'}
        </button>
      </div>
    </form>
  </FormCard>

  <h2 class="mb-4 mt-10 text-lg font-semibold text-[#F5F5F5]">Current records <span class="text-sm font-normal text-[#8a8a8a]">({data.educations.length})</span></h2>
  <div class="grid gap-4">
    {data.educations.map((item) => (
      <article class="flex flex-col gap-3 rounded-xl border border-[#262626] bg-[#111111] p-4 sm:flex-row sm:items-start sm:justify-between sm:p-5">
        <div class="min-w-0">
          <p class="mono text-[11px] uppercase tracking-[0.18em] text-[#8a8a8a]">{item.period}</p>
          <h3 class="mt-1 text-base font-medium text-[#F5F5F5]">{item.institution}</h3>
          <p class="text-sm text-[#A1A1A1]">{item.degree}</p>
          {item.details ? <p class="mt-2 text-sm leading-6 text-[#A1A1A1]">{item.details}</p> : null}
        </div>
        <div class="flex shrink-0 gap-2">
          <a href={`/admin/educations?edit=${item.id}`} class="min-h-[44px] rounded-lg border border-[#2E2E2E] px-4 text-sm leading-[42px] text-[#F5F5F5] transition-colors hover:bg-[#161616]">Edit link</a>
          <form method="POST" action="/api/admin/sections" data-confirm={`Delete “${item.degree} at ${item.institution}”?`}>
            <input type="hidden" name="section" value="educations" />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={item.id} />
            <button type="submit" class="min-h-[44px] rounded-lg border border-[#3f1f1f] px-4 text-sm text-[#fca5a5] transition-colors hover:bg-[#1b0f0f]">Delete</button>
          </form>
        </div>
      </article>
    ))}
    {data.educations.length === 0 ? <p class="rounded-xl border border-dashed border-[#2E2E2E] px-4 py-10 text-center text-sm text-[#8a8a8a]">No education records yet — add your first one above.</p> : null}
  </div>
</AdminShell>
