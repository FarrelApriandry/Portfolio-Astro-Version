---
import { ArrowUpRight, ExternalLink, Github, Linkedin, Mail, Rss } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ProjectExplorer, { toCardData } from '../components/ProjectExplorer.tsx';
import GitHubActivity from '../components/GitHubActivity.tsx';
import ResumeModal from '../components/ResumeModal.tsx';
import Footer from '../components/Footer.astro';
import HeroAvatar from '../components/3d/HeroAvatar.tsx';
import { getPortfolioData } from '../lib/db';
import resumeMarkdown from '../docs/CV.md?raw';

const { profile, socials, skillGroups, experiences, educations, projects, awards, intellectualProperties, degraded } = await getPortfolioData();

if (!profile) {
  throw new Error('Profile data is missing');
}

const navItems = [
  { label: 'Projects', href: '#projects' },
  { label: 'Tech Stack', href: '#tech-stack' },
  { label: 'Activity', href: '#activity' },
  { label: 'Writing', href: '#writing' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];

const socialMap = new Map(socials.map((social) => [social.platform.toLowerCase(), social.url]));

const heroSocialLinks = [
  { label: 'GitHub', href: socialMap.get('github') ?? 'https://github.com/FarrelApriandry', icon: Github },
  { label: 'LinkedIn', href: socialMap.get('linkedin') ?? 'https://linkedin.com/in/farrelapriandry', icon: Linkedin },
  { label: 'Email', href: socialMap.get('email') ?? `mailto:${profile.email}`, icon: Mail },
  { label: 'Blog', href: socialMap.get('medium') ?? socialMap.get('blog') ?? '#writing', icon: Rss },
];

const footerSocialLinks = [
  { label: 'GitHub', href: socialMap.get('github') ?? 'https://github.com/FarrelApriandry' },
  { label: 'LinkedIn', href: socialMap.get('linkedin') ?? 'https://linkedin.com/in/farrelapriandry' },
  { label: 'Email', href: socialMap.get('email') ?? `mailto:${profile.email}` },
  { label: 'Writing', href: socialMap.get('medium') ?? socialMap.get('blog') ?? '#writing' },
];

const engineeringNotes = [
  { id: '01', title: 'Designing a Self-Hosted HomeLab', meta: 'Linux · Docker · Networking' },
  { id: '02', title: 'Building a Real-Time System Monitoring Dashboard', meta: 'Node.js · WebSockets · Metrics' },
  { id: '03', title: 'Structuring TypeScript Backend Services', meta: 'Architecture · API · PostgreSQL' },
  { id: '04', title: 'What I Learned Building Nusantara', meta: 'Unreal Engine · Game Systems · Production' },
];

const currentlyBuilding = [
  { title: 'Personal HomeLab', meta: 'Linux · Docker · Networking' },
  { title: 'System Monitoring Platform', meta: 'TypeScript · Node.js · WebSockets' },
  { title: 'Full-Stack TypeScript Projects', meta: 'React · PostgreSQL · REST APIs' },
];

const currentYear = new Date().getFullYear();

// CDN-cache the public homepage (admin edits go live within ~10 min).
// Degraded fallback snapshots must never be cached — error banner data.
Astro.response.headers.set(
  'Cache-Control',
  degraded
    ? 'no-store'
    : 'public, s-maxage=600, stale-while-revalidate=86400',
);
---

<Layout title={`${profile.name} | ${profile.role}`} description={profile.value_statement}>
  <Navbar client:load brand={profile.name} items={navItems} contactHref="#contact" resumeHref="/resume.pdf" />

  <main id="top" class="relative z-10 mx-auto max-w-[1280px] px-4 pb-10 pt-12 sm:px-6 lg:px-8 lg:pt-20">
    {degraded ? (
      <p role="status" class="mono mb-10 rounded-2xl border border-[#7DD3A7]/30 bg-[#7DD3A7]/5 px-4 py-3 text-[11px] uppercase tracking-[0.18em] text-[#7DD3A7]">
        Showing cached content — live data is temporarily unavailable
      </p>
    ) : null}

    <!-- Hero — big open type, no boxes -->
    <section class="grid gap-16 pb-24 md:pb-32 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:pb-40">
      <div>
        <h1 class="max-w-[16ch] text-6xl font-black uppercase leading-[0.9] tracking-[-0.07em] text-[#F5F5F5] sm:text-7xl lg:text-[6.5rem]">
          {profile.name}
        </h1>
        <p class="mt-7 text-2xl font-medium text-[#D4D4D4] md:text-3xl">
          {profile.role}
        </p>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[#A1A1A1]">
          {profile.value_statement}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#contact"
            class="inline-flex items-center justify-center rounded-full bg-[#7DD3A7] px-7 py-3.5 text-sm font-semibold text-[#0A0A0A] transition-colors hover:bg-[#a7e3c4]"
          >
            Get in Touch
            <ArrowUpRight className="ml-2 h-4 w-4" />
          </a>
          <a
            href="/resume.pdf"
            class="inline-flex items-center justify-center rounded-full border border-[#2E2E2E] px-7 py-3.5 text-sm font-medium text-[#F5F5F5] transition-colors hover:border-[#4a4a4a]"
          >
            Download CV
          </a>
          <ResumeModal client:idle content={resumeMarkdown} />
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {heroSocialLinks.map((link) => {
            const Icon = link.icon;

            return (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                aria-label={link.label}
                class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#262626] text-[#A1A1A1] transition-colors hover:border-[#4a4a4a] hover:text-[#F5F5F5]"
              >
                <Icon className="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5" />
              </a>
            );
          })}
        </div>
      </div>

      <!-- Right: avatar as the focal object, status as quiet text (no panel) -->
      <div class="flex flex-col items-start lg:items-end">
        <HeroAvatar client:visible />

        <div class="mt-8 w-full max-w-sm lg:text-right">
          <p class="mono text-[11px] uppercase tracking-[0.22em] text-[#7DD3A7]">Currently building</p>
          <p class="mt-3 text-xl font-semibold tracking-[-0.03em] text-[#F5F5F5]">{profile.status}</p>
          <ul class="mt-4 space-y-1.5">
            {currentlyBuilding.map((item) => (
              <li class="text-sm text-[#8a8a8a]">
                {item.title} <span class="text-[#5a5a5a]">— {item.meta}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <ProjectExplorer client:visible projects={projects.map(toCardData)} />

    <GitHubActivity client:idle username="FarrelApriandry" />

    <!-- Tech stack — open rows instead of five boxes -->
    <section id="tech-stack" class="scroll-mt-28 pb-28 md:pb-36">
      <div class="mb-12 max-w-2xl md:mb-16">
        <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">Tech Stack</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#F5F5F5] md:text-5xl">Tools, chosen for the job.</h2>
      </div>

      <div>
        {skillGroups.map((group) => (
          <div class="grid gap-2 border-b border-[#1F1F1F] py-6 first:border-t md:grid-cols-[220px_1fr] md:gap-10">
            <p class="text-sm font-medium text-[#F5F5F5]">{group.label}</p>
            <p class="text-[15px] leading-7 text-[#A1A1A1]">{group.items.join(' · ')}</p>
          </div>
        ))}
      </div>

      <p class="mt-20 max-w-3xl text-2xl leading-9 text-[#D4D4D4] md:text-[1.7rem] md:leading-[2.6rem]">
        I prefer understanding the system behind the interface — from APIs and databases to networking and infrastructure. I build software as a complete system, not a frontend in isolation.
      </p>
    </section>

    <!-- Writing — quiet list, one honest note -->
    <section id="writing" class="scroll-mt-28 pb-28 md:pb-36">
      <div class="mb-12 max-w-2xl md:mb-16">
        <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">Writing</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#F5F5F5] md:text-5xl">Notes in progress.</h2>
      </div>

      <div>
        {engineeringNotes.map((note) => (
          <div class="flex items-baseline gap-6 border-b border-[#1F1F1F] py-6 first:border-t md:gap-10">
            <span class="mono min-w-[2rem] text-sm text-[#7DD3A7]">{note.id}</span>
            <div class="min-w-0 flex-1">
              <p class="text-lg font-medium text-[#F5F5F5]">{note.title}</p>
              <p class="mt-1 text-sm text-[#8a8a8a]">{note.meta}</p>
            </div>
            <span class="mono shrink-0 text-[11px] uppercase tracking-[0.14em] text-[#5a5a5a]">Draft</span>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-[#8a8a8a]">Full essays ship soon — technical threads land on LinkedIn first.</p>
    </section>

    <!-- About — timelines & rows, no nested cards -->
    <section id="about" class="scroll-mt-28 pb-28 md:pb-36">
      <div class="mb-12 max-w-2xl md:mb-16">
        <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">About</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#F5F5F5] md:text-5xl">Work, education, recognition.</h2>
      </div>

      <div class="grid gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
        <div class="space-y-16">
          <div>
            <h3 class="mono text-[11px] uppercase tracking-[0.22em] text-[#7DD3A7]">Experience</h3>
            <div class="mt-8">
              {experiences.slice(0, 4).map((experience) => (
                <div class="relative border-l border-[#262626] pb-10 pl-7 last:pb-0">
                  <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-[#7DD3A7]/80" aria-hidden="true"></span>
                  <p class="text-lg font-medium text-[#F5F5F5]">{experience.role}</p>
                  <p class="mt-1 text-sm text-[#8a8a8a]">{experience.company} · {experience.period}</p>
                  <p class="mt-3 max-w-xl text-[15px] leading-7 text-[#A1A1A1]">{experience.description}</p>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h3 class="mono text-[11px] uppercase tracking-[0.22em] text-[#7DD3A7]">Education</h3>
            <div class="mt-8">
              {educations.map((education) => (
                <div class="relative border-l border-[#262626] pb-10 pl-7 last:pb-0">
                  <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-[#7DD3A7]/80" aria-hidden="true"></span>
                  <p class="text-lg font-medium text-[#F5F5F5]">{education.institution}</p>
                  <p class="mt-1 text-sm text-[#8a8a8a]">{education.degree} · {education.period}</p>
                  {education.details ? <p class="mt-3 max-w-xl text-[15px] leading-7 text-[#A1A1A1]">{education.details}</p> : null}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-16">
          <div>
            <h3 class="mono text-[11px] uppercase tracking-[0.22em] text-[#7DD3A7]">Recognition</h3>
            <div class="mt-4">
              {awards.map((award) => (
                <article class="flex items-start justify-between gap-6 border-b border-[#1F1F1F] py-6 first:border-t">
                  <div class="min-w-0">
                    <p class="text-base font-medium text-[#F5F5F5]">{award.title}</p>
                    <p class="mt-1 text-sm text-[#8a8a8a]">{award.issuer}{award.description ? ` — ${award.description}` : ''}</p>
                  </div>
                  <div class="flex shrink-0 items-center gap-3">
                    <span class="mono text-sm text-[#8a8a8a]">{award.year}</span>
                    {award.link ? (
                      <a href={award.link} target="_blank" rel="noreferrer" aria-label={`Open ${award.title}`} class="text-[#A1A1A1] transition-colors hover:text-[#7DD3A7]">
                        <ExternalLink className="h-4 w-4" />
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div>
            <h3 class="mono text-[11px] uppercase tracking-[0.22em] text-[#7DD3A7]">Intellectual Property</h3>
            <div class="mt-4">
              {intellectualProperties.map((item) => (
                <article class="flex items-start justify-between gap-6 border-b border-[#1F1F1F] py-6 first:border-t">
                  <div class="min-w-0">
                    <p class="text-base font-medium text-[#F5F5F5]">{item.title}</p>
                    <p class="mt-1 text-sm text-[#8a8a8a]">{item.type} · {item.issuer}{item.description ? ` — ${item.description}` : ''}</p>
                  </div>
                  <div class="flex shrink-0 items-center gap-3">
                    <span class="mono text-sm text-[#8a8a8a]">{item.year}</span>
                    {item.link ? (
                      <a href={item.link} target="_blank" rel="noreferrer" aria-label={`Open ${item.title}`} class="text-[#A1A1A1] transition-colors hover:text-[#7DD3A7]">
                        <ExternalLink className="h-4 w-4" />
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer year={currentYear} links={navItems} email={profile.email} socials={footerSocialLinks} />
</Layout>
