---
import { ArrowUpRight, ExternalLink, Github, Linkedin, Mail, Rss } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import ProjectExplorer from '../components/ProjectExplorer.tsx';
import GitHubActivity from '../components/GitHubActivity.tsx';
import ResumeModal from '../components/ResumeModal.tsx';
import Footer from '../components/Footer.astro';
import { getPortfolioData } from '../lib/db';
import resumeMarkdown from '../docs/CV.md?raw';

const { profile, socials, skillGroups, experiences, educations, projects, awards, intellectualProperties } = await getPortfolioData();

if (!profile) {
  throw new Error('Profile data is missing');
}

const navItems = [
  { label: 'Projects', href: '#projects' },
  { label: 'Tech Stack', href: '#tech-stack' },
  { label: 'Activity', href: '#activity' },
  { label: 'Writing', href: '#writing' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];

const socialMap = new Map(socials.map((social) => [social.platform.toLowerCase(), social.url]));

const heroSocialLinks = [
  { label: 'GitHub', href: socialMap.get('github') ?? 'https://github.com/FarrelApriandry', icon: Github },
  { label: 'LinkedIn', href: socialMap.get('linkedin') ?? 'https://linkedin.com/in/farrelapriandry', icon: Linkedin },
  { label: 'Email', href: socialMap.get('email') ?? `mailto:${profile.email}`, icon: Mail },
  { label: 'Blog', href: socialMap.get('medium') ?? socialMap.get('blog') ?? '#writing', icon: Rss },
];

const footerSocialLinks = [
  { label: 'GitHub', href: socialMap.get('github') ?? 'https://github.com/FarrelApriandry' },
  { label: 'LinkedIn', href: socialMap.get('linkedin') ?? 'https://linkedin.com/in/farrelapriandry' },
  { label: 'Email', href: socialMap.get('email') ?? `mailto:${profile.email}` },
  { label: 'Writing', href: socialMap.get('medium') ?? socialMap.get('blog') ?? '#writing' },
];

const engineeringNotes = [
  { id: '01', title: 'Designing a Self-Hosted HomeLab', meta: 'Linux · Docker · Networking', href: '#contact', badge: 'Systems' },
  { id: '02', title: 'Building a Real-Time System Monitoring Dashboard', meta: 'Node.js · WebSockets · Metrics', href: '#contact', badge: 'Observability' },
  { id: '03', title: 'Structuring TypeScript Backend Services', meta: 'Architecture · API · PostgreSQL', href: '#contact', badge: 'Backend' },
  { id: '04', title: 'What I Learned Building Nusantara', meta: 'Unreal Engine · Game Systems · Production', href: '#contact', badge: 'Game Dev' },
];

const currentlyBuilding = [
  { id: '01', title: 'Personal HomeLab', meta: 'Linux · Docker · Networking' },
  { id: '02', title: 'System Monitoring Platform', meta: 'TypeScript · Node.js · WebSockets' },
  { id: '03', title: 'Full-Stack TypeScript Projects', meta: 'React · PostgreSQL · REST APIs' },
];

const currentYear = new Date().getFullYear();
---

<Layout title={`${profile.name} | ${profile.role}`} description={profile.value_statement}>
  <Navbar client:load brand={profile.name} items={navItems} contactHref="#contact" resumeHref="/resume.pdf" />

  <main id="top" class="relative z-10 mx-auto max-w-[1280px] px-4 pb-16 pt-10 sm:px-6 lg:px-8 lg:pb-24 lg:pt-14">
    <section class="pb-16 md:pb-20 lg:pb-24">
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div>
          <p class="mono text-[11px] font-medium uppercase tracking-[0.26em] text-[#7DD3A7]">Full-Stack TypeScript / Software Engineer</p>
          <h1 class="mt-6 max-w-[18ch] text-5xl font-black uppercase leading-[0.88] tracking-[-0.09em] text-[#F5F5F5] sm:text-6xl lg:text-7xl">
            Farrel Apriandry
          </h1>
          <p class="mt-5 text-xl font-medium text-[#D4D4D4] md:text-2xl">
            {profile.role}
          </p>
          <p class="mt-6 max-w-xl text-base leading-7 text-[#A1A1A1] md:text-lg">
            {profile.value_statement}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#contact"
              class="inline-flex items-center justify-center rounded-full border border-[#7DD3A7]/40 bg-[#7DD3A7]/10 px-5 py-3 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15"
            >
              Get in Touch
              <ArrowUpRight className="ml-2 h-4 w-4" />
            </a>
            <a
              href="/resume.pdf"
              class="inline-flex items-center justify-center rounded-full border border-[#262626] bg-[#111111] px-5 py-3 text-sm font-medium text-[#F5F5F5] transition-colors hover:border-[#3a3a3a] hover:bg-[#161616]"
            >
              Download CV
            </a>
            <ResumeModal client:idle content={resumeMarkdown} />
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            {heroSocialLinks.map((link) => {
              const Icon = link.icon;

              return (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                  aria-label={link.label}
                  class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#262626] bg-[#111111] text-[#D4D4D4] transition-colors hover:border-[#3a3a3a] hover:text-[#F5F5F5]"
                >
                  <Icon className="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5" />
                </a>
              );
            })}
          </div>
        </div>

        <aside class="rounded-3xl border border-[#262626] bg-[#111111] p-5 shadow-[0_0_0_1px_rgba(255,255,255,0.02)]">
          <div class="flex items-center justify-between border-b border-[#262626] pb-3">
            <p class="mono text-[10px] font-medium uppercase tracking-[0.22em] text-[#A1A1A1]">System Panel</p>
            <span class="inline-flex items-center gap-2 mono text-[10px] uppercase tracking-[0.18em] text-[#7DD3A7]">
              <span class="h-2 w-2 rounded-full bg-[#7DD3A7]" aria-hidden="true" />
              Active
            </span>
          </div>

          <div class="mt-5 space-y-5">
            <div>
              <p class="mono text-[10px] uppercase tracking-[0.22em] text-[#737373]">Building</p>
              <p class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-[#F5F5F5]">{profile.status}</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                <p class="mono text-[10px] uppercase tracking-[0.22em] text-[#737373]">Stack</p>
                <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">TypeScript / Node.js / PostgreSQL</p>
              </div>
              <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                <p class="mono text-[10px] uppercase tracking-[0.22em] text-[#737373]">Focus</p>
                <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">Systems, products, and developer tooling</p>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                <p class="mono text-[10px] uppercase tracking-[0.22em] text-[#737373]">Location</p>
                <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">{profile.location}</p>
              </div>
              <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                <p class="mono text-[10px] uppercase tracking-[0.22em] text-[#737373]">Email</p>
                <p class="mt-2 break-all text-sm leading-6 text-[#D4D4D4]">{profile.email}</p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <ProjectExplorer client:visible projects={projects} />

    <GitHubActivity client:idle username="FarrelApriandry" />

    <section id="tech-stack" class="pb-16 md:pb-20 lg:pb-24">
      <div class="mb-8 border-b border-[#262626] pb-4">
        <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">Tech Stack</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.06em] text-[#F5F5F5] md:text-4xl">System thinking, product building, and technical depth.</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        {skillGroups.map((group) => (
          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-5 transition-colors hover:border-[#3a3a3a]">
            <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#A1A1A1]">{group.label}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-[#262626] bg-[#0A0A0A] px-3 py-2 text-sm text-[#D4D4D4]">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 rounded-3xl border border-[#262626] bg-[#111111] p-6 md:p-8">
        <p class="max-w-4xl text-xl leading-8 text-[#D4D4D4] md:text-2xl">
          I prefer understanding the system behind the interface. From APIs and databases to networking and infrastructure, I enjoy building software as a complete system rather than treating the frontend as an isolated product.
        </p>
      </div>
    </section>

    <section id="writing" class="pb-16 md:pb-20 lg:pb-24">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <div class="mb-8 border-b border-[#262626] pb-4">
            <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">Writing</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.06em] text-[#F5F5F5] md:text-4xl">Notes on systems, process, and technical thinking.</h2>
          </div>

          <div class="grid gap-3">
            {engineeringNotes.map((note) => (
              <a
                href={note.href}
                class="group rounded-2xl border border-[#262626] bg-[#111111] p-4 transition-all hover:-translate-y-0.5 hover:border-[#3a3a3a] hover:bg-[#161616]"
              >
                <div class="flex items-start gap-4">
                  <span class="mono min-w-[2.5rem] text-sm text-[#7DD3A7]">{note.id}</span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#A1A1A1]">
                        {note.badge}
                      </span>
                      <span class="mono text-[10px] uppercase tracking-[0.16em] text-[#737373]">Editorial note</span>
                    </div>
                    <p class="mt-3 text-base font-medium text-[#F5F5F5]">{note.title}</p>
                    <p class="mt-1 mono text-[10px] uppercase tracking-[0.16em] text-[#A1A1A1]">{note.meta}</p>
                  </div>
                  <ExternalLink className="mt-1 h-4 w-4 text-[#A1A1A1] transition-transform group-hover:-translate-y-0.5 group-hover:text-[#F5F5F5]" />
                </div>
              </a>
            ))}
          </div>
        </div>

        <div>
          <div class="mb-8 border-b border-[#262626] pb-4">
            <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">Currently Building</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-[-0.06em] text-[#F5F5F5] md:text-4xl">Active projects and learning.</h2>
          </div>

          <div class="grid gap-3">
            {currentlyBuilding.map((item) => (
              <div class="rounded-2xl border border-[#262626] bg-[#111111] p-4">
                <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">{item.id}</p>
                <p class="mt-2 text-xl font-medium text-[#F5F5F5]">{item.title}</p>
                <p class="mt-2 mono text-[10px] uppercase tracking-[0.16em] text-[#A1A1A1]">{item.meta}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="pb-16 md:pb-20 lg:pb-24">
      <div class="mb-8 border-b border-[#262626] pb-4">
        <p class="mono text-[11px] uppercase tracking-[0.24em] text-[#7DD3A7]">About</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.06em] text-[#F5F5F5] md:text-4xl">Short bio, education, and recognition.</h2>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="space-y-8">
          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="mono rounded-full border border-[#1f3f2b] bg-[#0f1b14] px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#7DD3A7]">
                Bio
              </span>
              <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-2.5 py-1 text-[10px] uppercase tracking-[0.16em] text-[#A1A1A1]">
                {profile.status}
              </span>
            </div>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-[#D4D4D4] md:text-xl">
              {profile.value_statement}
            </p>
          </div>

          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
            <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#7DD3A7]">Experience</p>
            <div class="mt-5 space-y-5">
              {experiences.slice(0, 4).map((experience) => (
                <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                    <p class="text-base font-medium text-[#F5F5F5]">{experience.role}</p>
                    <span class="mono text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">{experience.period}</span>
                  </div>
                  <p class="mt-1 text-sm text-[#A1A1A1]">{experience.company}</p>
                  <p class="mt-3 text-sm leading-6 text-[#D4D4D4]">{experience.description}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
            <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#7DD3A7]">Education</p>
            <div class="mt-5 space-y-4">
              {educations.map((education) => (
                <div class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-baseline justify-between gap-4">
                    <p class="text-base font-medium text-[#F5F5F5]">{education.institution}</p>
                    <span class="mono text-[10px] uppercase tracking-[0.12em] text-[#A1A1A1]">{education.period}</span>
                  </div>
                  <p class="mt-1 text-sm text-[#D4D4D4]">{education.degree}</p>
                  {education.details ? <p class="mt-2 text-sm leading-6 text-[#A1A1A1]">{education.details}</p> : null}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
            <div class="flex items-center justify-between gap-3">
              <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#7DD3A7]">Recognition</p>
              <span class="mono text-[10px] uppercase tracking-[0.16em] text-[#737373]">Awards</span>
            </div>

            <div class="mt-5 grid gap-3">
              {awards.map((award) => (
                <article class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="mono rounded-full border border-[#262626] bg-[#111111] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">
                          Award
                        </span>
                        <span class="mono rounded-full border border-[#1f3f2b] bg-[#0f1b14] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#7DD3A7]">
                          {award.year}
                        </span>
                      </div>
                      <p class="mt-3 text-base font-medium text-[#F5F5F5]">{award.title}</p>
                      <p class="mt-1 text-sm text-[#A1A1A1]">{award.issuer}</p>
                      <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">{award.description}</p>
                    </div>

                    {award.link ? (
                      <a
                        href={award.link}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#262626] text-[#A1A1A1] transition-colors hover:border-[#3a3a3a] hover:text-[#F5F5F5]"
                        aria-label={`Open ${award.title}`}
                      >
                        <ExternalLink className="h-4 w-4" />
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
            <div class="flex items-center justify-between gap-3">
              <p class="mono text-[10px] uppercase tracking-[0.18em] text-[#7DD3A7]">Intellectual Property</p>
              <span class="mono text-[10px] uppercase tracking-[0.16em] text-[#737373]">HKI</span>
            </div>

            <div class="mt-5 grid gap-3">
              {intellectualProperties.map((item) => (
                <article class="rounded-2xl border border-[#262626] bg-[#0A0A0A] p-4">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="mono rounded-full border border-[#262626] bg-[#111111] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">
                          {item.type}
                        </span>
                        <span class="mono rounded-full border border-[#1f3f2b] bg-[#0f1b14] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#7DD3A7]">
                          {item.year}
                        </span>
                      </div>
                      <p class="mt-3 text-base font-medium text-[#F5F5F5]">{item.title}</p>
                      <p class="mt-1 text-sm text-[#A1A1A1]">{item.issuer}</p>
                      <p class="mt-2 text-sm leading-6 text-[#D4D4D4]">{item.description}</p>
                    </div>

                    {item.link ? (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#262626] text-[#A1A1A1] transition-colors hover:border-[#3a3a3a] hover:text-[#F5F5F5]"
                        aria-label={`Open ${item.title}`}
                      >
                        <ExternalLink className="h-4 w-4" />
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer year={currentYear} links={navItems} email={profile.email} socials={footerSocialLinks} />
</Layout>
