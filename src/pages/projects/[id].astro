---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.astro';
import { getPortfolioData } from '../../lib/db';
import { toCardData } from '../../components/ProjectExplorer.tsx';

const { id } = Astro.params;
const { profile, socials, projects } = await getPortfolioData();

if (!profile) {
  throw new Error('Profile data is missing');
}

const project = projects.find((p) => p.id === id);

if (!project) {
  return Astro.redirect('/#projects');
}

const card = toCardData(project);
const gallery = (project.gallery ?? []).filter(Boolean);
const responsibilities = (project.role_responsibilities ?? []).filter(Boolean);
const heroImage = card.image;

const navItems = [
  { label: 'Projects', href: '/#projects' },
  { label: 'Tech Stack', href: '/#tech-stack' },
  { label: 'Activity', href: '/#activity' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];

const socialMap = new Map(socials.map((social) => [social.platform.toLowerCase(), social.url]));
const footerSocialLinks = [
  { label: 'GitHub', href: socialMap.get('github') ?? 'https://github.com/FarrelApriandry' },
  { label: 'LinkedIn', href: socialMap.get('linkedin') ?? 'https://linkedin.com/in/farrelapriandry' },
  { label: 'Email', href: socialMap.get('email') ?? `mailto:${profile.email}` },
];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  dateCreated: String(project.year),
  author: { '@type': 'Person', name: profile.name, url: 'https://portfolio.relapri.my.id' },
};
---

<Layout
  title={`${project.title} | ${profile.name}`}
  description={project.summary}
  image={heroImage ?? '/og-image.png'}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <Navbar client:load brand={profile.name} items={navItems} contactHref="/#contact" resumeHref="/resume.pdf" />

  <main class="relative z-10 mx-auto max-w-[960px] px-4 pb-16 pt-10 sm:px-6 lg:px-8 lg:pb-24 lg:pt-14">
    <nav aria-label="Breadcrumb" class="mono text-[11px] uppercase tracking-[0.18em] text-[#737373]">
      <a href="/#projects" class="transition-colors hover:text-[#F5F5F5]">Projects</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-[#A1A1A1]">{project.title}</span>
    </nav>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">
          {card.bucket}
        </span>
        <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">
          {project.category} · {project.year}
        </span>
        <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] text-[#A1A1A1]">
          {project.role}
        </span>
      </div>
      <h1 class="mt-5 text-4xl font-bold tracking-[-0.06em] text-[#F5F5F5] md:text-5xl">{project.title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-[#A1A1A1]">{project.summary}</p>

      {project.links ? (
        <div class="mt-6 flex flex-wrap gap-3">
          {Object.entries(project.links).map(([key, value]) => (
            <a
              href={value}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-[#262626] bg-[#111111] px-4 py-2 text-sm text-[#F5F5F5] transition-colors hover:border-[#3a3a3a] hover:bg-[#161616]"
            >
              {key.replace(/_/g, ' ')}
            </a>
          ))}
        </div>
      ) : null}
    </header>

    {heroImage ? (
      <figure class="mt-10 overflow-hidden rounded-3xl border border-[#262626] bg-[#0A0A0A]">
        <img
          src={heroImage}
          alt={project.alt || project.title}
          class="aspect-[16/9] w-full object-cover"
          loading="eager"
          decoding="async"
          width={960}
          height={540}
        />
      </figure>
    ) : null}

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <section class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">Problem</p>
        <p class="mt-3 text-base leading-7 text-[#D4D4D4]">{project.problem || project.summary}</p>
      </section>
      <section class="rounded-3xl border border-[#262626] bg-[#111111] p-6">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">Solution</p>
        <p class="mt-3 text-base leading-7 text-[#D4D4D4]">{project.solution || project.summary}</p>
      </section>
    </div>

    <section class="mt-5 rounded-3xl border border-[#262626] bg-[#111111] p-6">
      <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">Architecture</p>
      <p class="mt-3 max-w-3xl text-base leading-7 text-[#D4D4D4]">{project.architecture_notes || card.impact}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {project.technologies.map((tech) => (
          <span class="mono rounded-full border border-[#262626] bg-[#0A0A0A] px-3 py-1.5 text-[11px] uppercase tracking-[0.12em] text-[#A1A1A1]">
            {tech}
          </span>
        ))}
      </div>
    </section>

    {responsibilities.length ? (
      <section class="mt-5 rounded-3xl border border-[#262626] bg-[#111111] p-6">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">My role</p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-base leading-7 text-[#D4D4D4]">
          {responsibilities.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ) : null}

    {gallery.length ? (
      <section class="mt-5 rounded-3xl border border-[#262626] bg-[#111111] p-6">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-[#7DD3A7]">Gallery</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {gallery.map((src, i) => (
            <figure class="overflow-hidden rounded-2xl border border-[#262626] bg-[#0A0A0A]">
              <img
                src={src.startsWith('/') ? src : `/${src}`}
                alt={`${project.title} screenshot ${i + 1}`}
                class="aspect-[16/9] w-full object-cover"
                loading="lazy"
                decoding="async"
                width={640}
                height={360}
              />
            </figure>
          ))}
        </div>
      </section>
    ) : null}

    <nav class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-[#262626] bg-[#111111] p-6">
      <a href="/#projects" class="text-sm text-[#A1A1A1] transition-colors hover:text-[#F5F5F5]">
        ← All projects
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center rounded-full border border-[#7DD3A7]/40 bg-[#7DD3A7]/10 px-5 py-3 text-sm font-medium text-[#F5F5F5] transition-colors hover:bg-[#7DD3A7]/15"
      >
        Discuss a project like this
      </a>
    </nav>
  </main>

  <Footer year={new Date().getFullYear()} links={navItems} email={profile.email} socials={footerSocialLinks} />
</Layout>
